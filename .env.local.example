# Development-only server routing. Copy this file to .env.development.local, not .env.local.
# Next loads .env.local ahead of .env.production during next build, which can override production HTTPS.
# MANAGER_ORIGIN must match Nest ORGANIZATION_PORTAL_ORIGIN exactly.
GYM_API_BASE_URL=http://127.0.0.1:3000
MANAGER_ORIGIN=http://localhost:4001
